# ==============================================================================
# Peshkar AI — Production Environment Configuration (.env.production.example)
# ==============================================================================
# IMPORTANT:
# - Production Clerk keys start with 'pk_live_' and 'sk_live_'.
# - NEVER use 'pk_test_' or 'sk_test_' in production. The security layer will abort.
# - NEVER use 'pk_live_' or 'sk_live_' in local development.
# ==============================================================================

# --- Node & Network ---
NODE_ENV=production
PORT=8000
BASE_URL=https://api.listinglift.com
FRONTEND_URL=https://listinglift.com
ALLOWED_ORIGINS=https://listinglift.com,https://www.listinglift.com,https://app.listinglift.com

# --- Production MongoDB (Replica Set / Atlas with TLS) ---
MONGODB_URI=mongodb+srv://<prod_db_user>:<prod_db_password>@cluster0.mongodb.net/listinglift_prod?retryWrites=true&w=majority

# --- Production Redis (BullMQ + Rate Limiting with TLS / Auth) ---
REDIS_URL=rediss://default:<redis_auth_token>@redis-prod.upstash.io:6379

# --- Production Clerk Auth (Live Instance ONLY) ---
# Retrieve from Clerk Dashboard -> Choose Production Instance -> API Keys
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_PRODUCTION_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY

# Clerk Production Webhook Secret (from Clerk Dashboard -> Webhooks -> Production Endpoint)
# Endpoint URL must be: https://api.listinglift.com/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET

# Clerk Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# --- Cloudflare R2 Storage (Production Bucket) ---
R2_ACCOUNT_ID=YOUR_PRODUCTION_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_PRODUCTION_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_PRODUCTION_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=listinglift-production-uploads
R2_PUBLIC_URL=https://cdn.listinglift.com

# --- Razorpay Live Credentials ---
# In production, use live keys (rzp_live_...)
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_WEBHOOK_SECRET

# --- AI APIs ---
OPENAI_API_KEY=sk-proj-YOUR_PRODUCTION_OPENAI_KEY
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY

# --- Frontend API Endpoint ---
NEXT_PUBLIC_API_URL=https://api.listinglift.com/trpc

# --- Logger ---
LOGGER_LEVEL=info
