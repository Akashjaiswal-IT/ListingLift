# ==============================================================================
# Peshkar AI — Universal Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file:
#   - For Local Dev:   cp .env.example .env
#   - For Production: cp .env.example .env.production
# ==============================================================================

# --- Environment & Server ---
# Local: development | Production: production
NODE_ENV=development
PORT=8000

# Backend Base URL
# Local: http://localhost:8000 | Production: https://api.peshkarai.in
BASE_URL=http://localhost:8000

# Frontend URL & Allowed CORS Origins
# Local: http://localhost:3000 | Production: https://www.peshkarai.in
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://peshkarai.in,https://www.peshkarai.in
# Public website used for canonical URLs and social metadata.
# Production: https://www.peshkarai.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- MongoDB Database ---
# Local Docker:      mongodb://root:password@localhost:27017/peshkar?authSource=admin
# Production Server: mongodb://root:YOUR_PASSWORD@mongodb:27017/peshkar?authSource=admin&replicaSet=rs0
#   (production MongoDB runs as a one-node replica set so transactions work; see docs/runbooks/mongo-replica-set.md)
MONGODB_URI=mongodb://root:password@localhost:27017/peshkar?authSource=admin

# MongoDB Container Credentials (used by docker-compose)
MONGO_PASSWORD=password
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=peshkar

# --- Redis (BullMQ Queues & Caching) ---
# Local Docker:      redis://localhost:6379
# Production Server: redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- Clerk Authentication ---
# In Development: Use pk_test_... and sk_test_...
# In Production:  Use pk_live_... and sk_live_... (strict validation will abort if test keys are used in prod)
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_CLERK_WEBHOOK_SECRET

# Clerk UI Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# --- Cloudflare R2 Storage (S3-Compatible) ---
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=peshkar
# Public host for generated images & cards (permanent links, e.g. in Excel exports).
# Use the assets Worker URL (apps/assets-worker, e.g. https://peshkar-assets.<account>.workers.dev)
# or a custom domain. NOT the private *.r2.cloudflarestorage.com endpoint.
R2_PUBLIC_URL=https://peshkar-assets.YOUR_ACCOUNT.workers.dev

# --- Razorpay Payment Gateway ---
# In Development: Use rzp_test_...
# In Production:  Use rzp_live_...
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# --- AI APIs ---
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Frontend Client API Endpoint ---
# Local: http://localhost:8000/trpc | Production: https://api.peshkarai.in/trpc
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# --- PostHog Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Logger ---
# Development: debug | Production: info
LOGGER_LEVEL=debug

# --- Rate limits & capacity (all optional; defaults shown) ---
# Gemini limits are per Google Cloud project. Read your model's RPM in AI Studio > Rate limits and
# set GEMINI_MAX_RPM a little below it. Tier 1 also caps spend at $10 per rolling 10 minutes.
GEMINI_MAX_RPM=20
GEMINI_SPEND_LIMIT_USD_PER_10_MIN=8
GEMINI_CALL_TIMEOUT_MS=150000
WORKER_GENERATION_CONCURRENCY=3
WORKER_RE_EDIT_CONCURRENCY=3
# New generations are refused (before charging) when this many jobs are already waiting
MAX_WAITING_JOBS=50
# Requests per minute per client IP across the API (webhooks and /health excluded)
API_IP_RATE_LIMIT_PER_MIN=600
# Proxies in front of the API (Traefik -> Caddy = 2). Verify with GET https://api.peshkarai.in/ip
TRUST_PROXY_HOPS=2
