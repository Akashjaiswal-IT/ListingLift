# ============================================
# ListingLift — Environment Variables Template
# ============================================

# --- General ---
NODE_ENV=development
PORT=8000
BASE_URL=http://localhost:8000

# --- MongoDB ---
MONGODB_URI=mongodb://root:password@localhost:27017/listinglift?authSource=admin

# --- Redis (BullMQ + caching) ---
REDIS_URL=redis://localhost:6379

# --- Clerk Auth ---
CLERK_PUBLISHABLE_KEY=pk_test_bGlzdGluZ2xpZnQuY2xlcmsuYWNjb3VudHMuZGV2JA==
CLERK_SECRET_KEY=sk_test_mocksecretkeyforlocaldev123456789
CLERK_WEBHOOK_SECRET=whsec_mockwebhooksecretforlocaldev123456
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bGlzdGluZ2xpZnQuY2xlcmsuYWNjb3VudHMuZGV2JA==
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=listinglift-uploads
R2_PUBLIC_URL=https://pub-YOUR_R2_PUBLIC_URL.r2.dev

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# --- OpenAI ---
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY

# --- Google Gemini ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# --- Logger ---
LOGGER_LEVEL=debug
