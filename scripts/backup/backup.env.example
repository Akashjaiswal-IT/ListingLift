# Settings for scripts/backup/mongo-backup.sh (Peshkar AI hourly MongoDB backup).
#
# On the server this file lives at /etc/peshkar-backup/backup.env, owned by root, mode 600:
#   sudo install -d -m 700 /etc/peshkar-backup
#   sudo install -m 600 scripts/backup/backup.env.example /etc/peshkar-backup/backup.env
#   sudo nano /etc/peshkar-backup/backup.env
#
# Format: one KEY=value per line. The file is read as plain text, never run as a script, so
# values may contain any character. Optional surrounding "double" or 'single' quotes are removed.
# No comments at the end of a line (a # after the value becomes part of the value).
#
# EVERY VALUE BELOW IS A PLACEHOLDER. This repository is public: never commit real values.

# ---------------------------------------------------------------- the app
# Folder on the server that contains docker-compose.server.yml, .env.production and mongo-keyfile
# (the folder where you run `git pull`). Run `pwd` in it to see the exact path.
APP_DIR=/path/to/ListingLift

# Name of the MongoDB container (container_name in docker-compose.server.yml).
MONGO_CONTAINER=peshkar-mongodb

# The app's database name (MONGO_INITDB_DATABASE in .env.production).
MONGO_DB=peshkar

# ---------------------------------------------------------------- MongoDB backup user
# Least-privilege user (roles: backup + clusterMonitor) created by
# scripts/backup/create-backup-user.sh. Generate the password with:  openssl rand -hex 32
MONGO_BACKUP_USER=peshkar_backup
MONGO_BACKUP_PASSWORD=CHANGE_ME_run_openssl_rand_hex_32

# ---------------------------------------------------------------- encryption (age)
# Your age PUBLIC key (starts with age1...). The matching PRIVATE key (AGE-SECRET-KEY-1...)
# stays offline with you and must NEVER be put on this server.
# Several public keys may be listed, separated by spaces or commas; any one of the matching
# private keys can then decrypt.
AGE_RECIPIENT=age1replacewithyourpublickeyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- Cloudflare R2 (rclone)
# Name of the R2 bucket that holds the backups (a bucket used ONLY for backups).
R2_BUCKET=peshkar-db-backups

# rclone reads the "r2" remote entirely from these variables (no rclone.conf needed).
# Use the WRITE token ("Object Read & Write", limited to the backup bucket).
RCLONE_REMOTE=r2
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME_access_key_id
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME_secret_access_key
RCLONE_CONFIG_R2_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ACL=private
# The token may only touch objects in this one bucket, so never try to create the bucket.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# Hour of the day (UTC, 0-23) from which the once-a-day copies are made: the archive goes to
# mongodump/daily/YYYY/MM/ and .env.production + mongo-keyfile go to config/YYYY/MM/.
# The first successful run at or after this hour does it; if that run fails, the next hour retries.
# 21 UTC = 02:30 India time (quiet hours).
DAILY_UTC_HOUR=21

# ---------------------------------------------------------------- alerts (Healthchecks.io)
# Ping URL of the "hourly backup" check, e.g. https://hc-ping.com/<uuid>. Treat it as a secret.
HC_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------- local copies (optional)
# Plain (unencrypted) local copies for fast restores. Only the newest KEEP_LOCAL are kept.
LOCAL_BACKUP_DIR=/var/backups/peshkar/local
KEEP_LOCAL=24
# Scratch space for encrypted files while they upload (emptied after every run).
WORK_DIR=/var/backups/peshkar/work
# The backup refuses to run when this disk is at least this full (percent).
DISK_CHECK_PATH=/
DISK_MAX_USED_PCT=90

# ---------------------------------------------------------------- advanced (rarely changed)
# Collections whose document counts go into the manifest (checked by the weekly restore test).
MANIFEST_COLLECTIONS=users creditledgers payments listingobjects
# Files from APP_DIR copied (encrypted) to config/YYYY/MM/ once a day.
CONFIG_FILES=.env.production mongo-keyfile
