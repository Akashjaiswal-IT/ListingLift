# ==============================================================================
# Peshkar AI — Production Server Environment (.env.production)
# ==============================================================================
# Copy this file to .env.production on your server and fill in real values.
# The docker-compose.server.yml reads from this file.
# ==============================================================================

# --- General ---
NODE_ENV=production
PORT=8000
BASE_URL=https://api.peshkarai.in
FRONTEND_URL=https://peshkarai.in
ALLOWED_ORIGINS=https://peshkarai.in,https://www.peshkarai.in

# --- MongoDB ---
# Connect to the internal MongoDB container (uses MONGO_PASSWORD below)
MONGODB_URI=mongodb://root:YOUR_SECURE_MONGO_PASSWORD@mongodb:27017/peshkar?authSource=admin

# Root password used by the MongoDB container
MONGO_PASSWORD=YOUR_SECURE_MONGO_PASSWORD
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=YOUR_SECURE_MONGO_PASSWORD
MONGO_INITDB_DATABASE=peshkar

# --- Redis (BullMQ queue & caching) ---
# Connect to the internal Redis container on the private Docker bridge network
REDIS_URL=redis://redis:6379

# --- Clerk Auth (USE LIVE KEYS FOR PRODUCTION) ---
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_YOUR_PRODUCTION_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_PUBLISHABLE_KEY
CLERK_WEBHOOK_SECRET=whsec_YOUR_PRODUCTION_WEBHOOK_SECRET

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app/dashboard

# --- Cloudflare R2 Storage ---
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=peshkar
R2_PUBLIC_URL=https://YOUR_R2_PUBLIC_DOMAIN

# --- Razorpay (USE LIVE KEYS FOR PRODUCTION) ---
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_LIVE_WEBHOOK_SECRET

# --- AI APIs ---
OPENAI_API_KEY=sk-proj-YOUR_PRODUCTION_OPENAI_KEY
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY

# --- Logger ---
LOGGER_LEVEL=info
